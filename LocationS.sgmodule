#!name=LocationS
#!desc=自用
#!category= iRingo
#!date=2026-11-13

[Rule]
DOMAIN,gspe1-ssl.ls.apple.com,DIRECT
DOMAIN,dispatcher.is.autonavi.com,DIRECT

[Script]
LocationService.pep.gcc.response = type=http-response, pattern=^https?:\/\/gspe1-ssl\.ls\.apple\.com\/pep\/gcc, requires-body=1, script-path=https://github.com/NSRingo/LocationService/releases/download/v1.0.1/response.bundle.js, argument=GeoCountryCode="US"&Dispatcher.Hybrid="true"&LogLevel="WARN"
LocationService.Dispatcher.request = type=http-request, pattern=^https?:\/\/dispatcher\.is\.autonavi\.com\/dispatcher, requires-body=1, binary-body-mode=1, debug=1, script-path=https://github.com/NSRingo/LocationService/releases/download/v1.0.1/request.bundle.js, argument=GeoCountryCode="US"&Dispatcher.Hybrid="true"&LogLevel="WARN"
LocationService.Dispatcher.response = type=http-response, pattern=^https?:\/\/dispatcher\.is\.autonavi\.com\/dispatcher, requires-body=1, binary-body-mode=1, debug=1, script-path=https://github.com/NSRingo/LocationService/releases/download/v1.0.1/response.bundle.js, argument=GeoCountryCode="US"&Dispatcher.Hybrid="true"&LogLevel="WARN"

[MITM]
hostname = %APPEND% gspe1-ssl.ls.apple.com, dispatcher.is.autonavi.com